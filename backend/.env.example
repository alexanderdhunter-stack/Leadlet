# Leadlet Backend Configuration

# Database (use SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///./leadlet.db
# DATABASE_URL=postgresql://user:password@localhost/leadlet

# Anthropic API Key (required for image processing)
ANTHROPIC_API_KEY=your-api-key-here

# Claude Model (default: claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Application settings
DEBUG=true
SECRET_KEY=change-me-in-production

# File upload limits
MAX_UPLOAD_SIZE_MB=50
